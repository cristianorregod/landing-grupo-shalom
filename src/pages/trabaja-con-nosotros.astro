---
import Page from '../layouts/Page.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import CollageHero from '../components/ui/CollageHero.astro';
import DividedList from '../components/ui/DividedList.astro';
import ComposeForm from '../components/ui/ComposeForm.astro';
import FormField from '../components/ui/FormField.astro';
import { site } from '../config/site';
import { jobAreas, jobsPage } from '../content/jobs-page';

const { seo, hero, vacancies, areas, apply } = jobsPage;
const { phone, email } = site.contact;
const areaOptions = jobAreas.map((area) => ({ value: area.title, label: area.title }));
---

<Page title={seo.title} description={seo.description}>
  <CollageHero title={hero.title} photos={hero.photos} tone="mist">
    <p>{hero.body}</p>
    <Fragment slot="actions">
      <Button href="#postular" variant="blue">
        Enviar mi hoja de vida
      </Button>
      <Button href="#areas" variant="outline-blue">
        Ver áreas de trabajo
      </Button>
    </Fragment>
  </CollageHero>

  <section class="bg-white py-16 lg:py-24">
    <Container>
      <h2 class="text-4xl leading-[1.05] font-bold text-balance text-ink sm:text-5xl" data-reveal>
        {vacancies.title}
      </h2>
      <p class="mt-4 text-base text-ink/90 sm:text-lg" data-reveal>
        {vacancies.lead}
      </p>

      {vacancies.items.length > 0 ? (
        <ul class="mt-10 grid gap-5 md:grid-cols-2" data-reveal-stagger>
          {vacancies.items.map((vacancy) => (
            <li class="hover-lift flex flex-col items-start rounded-3xl bg-mist p-7 sm:p-9">
              <p class="text-xs font-bold tracking-[0.2em] text-eyebrow uppercase">
                {vacancy.area} · {vacancy.location}
              </p>
              <h3 class="mt-3 text-2xl leading-tight font-bold text-ink">{vacancy.title}</h3>
              <p class="mt-3 text-base text-ink/90">{vacancy.description}</p>
              <Button href="#postular" variant="blue" size="sm" class="mt-6">
                Postularme
              </Button>
            </li>
          ))}
        </ul>
      ) : (
        <div
          data-reveal
          class="mt-10 grid items-center gap-8 rounded-3xl bg-mist p-7 sm:p-10 md:grid-cols-[3fr_2fr]"
        >
          <div>
            <h3 class="text-2xl leading-tight font-bold text-ink">{vacancies.emptyTitle}</h3>
            <p class="mt-3 text-base text-ink/90">{vacancies.emptyBody}</p>
          </div>
          <div class="flex flex-col gap-3">
            <Button href="#postular" variant="blue">
              Enviar mi hoja de vida
            </Button>
            <Button href={phone.whatsappHref} variant="light">
              Escribir por WhatsApp
            </Button>
          </div>
        </div>
      )}
    </Container>
  </section>

  <section id="areas" class="bg-mist py-16 lg:py-24">
    <Container>
      <h2
        data-reveal
        class="max-w-2xl text-4xl leading-[1.05] font-bold text-balance text-ink sm:text-5xl"
      >
        {areas.title}
      </h2>
      <p class="mt-4 max-w-xl text-base text-ink/90 sm:text-lg" data-reveal>
        {areas.lead}
      </p>
      <DividedList items={jobAreas} class="mt-10" />
    </Container>
  </section>

  <section id="postular" class="bg-brand-blue py-16 text-white lg:py-24">
    <Container class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <h2 class="text-4xl leading-[1.05] font-bold text-balance sm:text-5xl">{apply.title}</h2>
        <p class="mt-4 max-w-md text-base text-white sm:text-lg">{apply.lead}</p>
        <ul class="mt-6 max-w-md space-y-3 text-base text-white">
          {apply.steps.map((step) => (
            <li class="relative pl-5 before:absolute before:top-[0.6em] before:left-0 before:size-1.5 before:rounded-full before:bg-white">
              {step}
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-3xl bg-white p-6 text-ink shadow-xl shadow-navy/30 sm:p-8" data-reveal>
        <h3 class="mb-5 text-xl font-bold">{apply.formTitle}</h3>
        <ComposeForm
          phoneDigits={phone.digits}
          email={email}
          subject={apply.subject}
          lines={apply.lines}
          privacyHref={site.links.privacyPolicy}
        >
          <FormField
            id="job-name"
            name="name"
            label="Nombre completo"
            required
            autocomplete="name"
            minlength={3}
            maxlength={80}
          />
          <FormField
            id="job-city"
            name="city"
            label="Ciudad"
            required
            autocomplete="address-level2"
            maxlength={60}
          />
          <FormField
            id="job-area"
            name="area"
            label="Área de interés"
            as="select"
            required
            options={areaOptions}
          />
        </ComposeForm>
      </div>
    </Container>
  </section>
</Page>
