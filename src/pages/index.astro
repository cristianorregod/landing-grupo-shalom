---
import Base from '../layouts/Base.astro';
import Header from '../components/sections/Header.astro';
import WhatsAppFab from '../components/sections/WhatsAppFab.astro';
import Hero from '../components/sections/Hero.astro';
import Clients from '../components/sections/Clients.astro';
import Improvise from '../components/sections/Improvise.astro';
import Trajectory from '../components/sections/Trajectory.astro';
import OurPromise from '../components/sections/OurPromise.astro';
import Solutions from '../components/sections/Solutions.astro';
import Press from '../components/sections/Press.astro';
import Catalog from '../components/sections/Catalog.astro';
import About from '../components/sections/About.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import Footer from '../components/sections/Footer.astro';
---

<Base>
  <Header />
  <main id="top" class="pt-16 lg:pt-20">
    <Hero />
    <Clients />
    <Improvise />
    <Trajectory />
    <OurPromise />
    <Solutions />
    <Press />
    <Catalog />
    <About />
    <FinalCta />
  </main>
  <Footer />
  <WhatsAppFab />
</Base>
