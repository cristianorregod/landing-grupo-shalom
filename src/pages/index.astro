---
import Base from '../layouts/Base.astro';
import Header from '../components/sections/Header.astro';
import WhatsAppFab from '../components/sections/WhatsAppFab.astro';
import Hero from '../components/sections/Hero.astro';
import Clients from '../components/sections/Clients.astro';
import Container from '../components/ui/Container.astro';

// Temporary stubs keep every anchor in place until each section is built.
const stubs = [
  { id: 'garantizamos', label: 'Mientras unos improvisan (Phase 5)', tone: 'bg-white' },
  { id: 'trayectoria', label: 'Trajectory (Phase 5)', tone: 'bg-white' },
  { id: 'garantia', label: 'Promise: Garantía & Capacidad (Phase 5)', tone: 'bg-beige' },
  { id: 'soluciones', label: 'Solutions (Phase 6)', tone: 'bg-beige' },
  { id: 'prensa', label: 'Press (Phase 6)', tone: 'bg-white' },
  { id: 'catalogo', label: 'Catalog (Phase 7)', tone: 'bg-beige' },
  { id: 'quienes-somos', label: 'About (Phase 7)', tone: 'bg-white' },
  { id: 'contacto', label: 'Final CTA (Phase 7)', tone: 'bg-cta-from text-white' },
];
---

<Base>
  <Header />
  <main id="top" class="pt-16 lg:pt-20">
    <Hero />
    <Clients />
    {stubs.map((stub) => (
      <section id={stub.id} class:list={['flex min-h-[70vh] items-center', stub.tone]}>
        <Container>
          <p class="text-2xl font-bold">{stub.label}</p>
        </Container>
      </section>
    ))}
  </main>
  <WhatsAppFab />
</Base>
