---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import RichText from '../ui/RichText.astro';
import CatalogCta from './CatalogCta.astro';
import { catalogSection, categories } from '../../content/catalog';

const cardClass =
  'flex h-full items-center gap-4 rounded-3xl border-2 border-brand-blue bg-transparent p-4 sm:p-5';
---

<section id="catalogo" class="bg-beige py-16 lg:py-24">
  <Container>
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-16">
      <div>
        <Eyebrow>{catalogSection.eyebrow}</Eyebrow>
        <h2 class="mt-3 max-w-xl text-3xl leading-tight font-bold text-balance text-ink sm:text-4xl">
          {catalogSection.title}
        </h2>
        <p class="mt-4 max-w-xl text-base text-ink/90 sm:text-lg">
          <RichText text={catalogSection.lead} />
        </p>
      </div>
      <!-- Desktop only: below lg the CTA appears once, after the grid. -->
      <div class="hidden lg:block">
        <CatalogCta />
      </div>
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {categories.map((category) => {
        const content = (
          <>
            <img
              src={category.icon}
              alt=""
              width="72"
              height="72"
              loading="lazy"
              decoding="async"
              class="size-16 shrink-0 sm:size-[4.5rem]"
            />
            <div class="min-w-0">
              <h3 class="text-xl leading-tight font-bold text-ink sm:text-2xl lg:text-xl xl:text-2xl">
                {category.name}
              </h3>
              <p class="mt-1 text-sm leading-snug text-ink/90">{category.description}</p>
            </div>
          </>
        );
        return (
          <li>
            {category.href ? (
              <a href={category.href} class:list={[cardClass, 'transition-colors hover:bg-white']}>
                {content}
              </a>
            ) : (
              <div class={cardClass}>{content}</div>
            )}
          </li>
        );
      })}
      <li class="flex items-center sm:col-span-2 lg:col-span-1 lg:pl-2">
        <CatalogCta class="mt-4 lg:mt-0" />
      </li>
    </ul>
  </Container>
</section>
