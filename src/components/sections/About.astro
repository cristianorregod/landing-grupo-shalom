---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import RichText from '../ui/RichText.astro';
import ResponsiveImage from '../ui/ResponsiveImage.astro';
import { about } from '../../content/company';
---

<section id="quienes-somos" class="bg-white py-16 lg:py-24">
  <Container class="grid items-center gap-10 md:grid-cols-[2fr_3fr] lg:gap-16">
    <ResponsiveImage
      src={about.image}
      alt={about.imageAlt}
      widths={[400, 600, 910]}
      sizes="(min-width: 1216px) 420px, (min-width: 768px) 38vw, 100vw"
      class="aspect-4/5 w-full rounded-3xl object-cover max-md:max-h-[28rem]"
    />
    <div>
      <Eyebrow>{about.eyebrow}</Eyebrow>
      <h2 class="mt-3 text-4xl leading-[1.02] font-bold text-balance text-ink sm:text-5xl xl:text-[3.5rem]">
        {about.title}
      </h2>
      <p class="mt-6 max-w-xl text-base text-ink/90 sm:text-lg">
        <RichText text={about.body} strongClass="font-bold text-navy" />
      </p>
    </div>
  </Container>
</section>
