---
import Container from '../ui/Container.astro';
import Carousel from '../ui/Carousel.astro';
import ResponsiveImage from '../ui/ResponsiveImage.astro';
import RichText from '../ui/RichText.astro';
import { improvise } from '../../content/story';
---

<section id="garantizamos" class="bg-white py-16 lg:py-24">
  <Container class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
    <div>
      <span class="block h-1 w-16 bg-brand-blue" aria-hidden="true"></span>
      <p class="mt-5 max-w-md text-base text-ink/90 sm:text-lg">{improvise.intro}</p>
      <h2 class="mt-5 text-4xl leading-[1.02] font-bold text-balance text-ink sm:text-5xl xl:text-[3.5rem]">
        {improvise.title}
      </h2>
      <p class="mt-6 max-w-md text-base text-ink/90 sm:text-lg">
        <RichText text={improvise.body} />
      </p>
    </div>

    <Carousel label="Galería de operación" autoplay={6000}>
      {improvise.slides.map((slide) => (
        <li class="w-full">
          <ResponsiveImage
            src={slide.image}
            alt={slide.alt}
            sizes="(min-width: 1216px) 560px, (min-width: 1024px) 45vw, 100vw"
            class="aspect-4/3 w-full rounded-3xl object-cover"
          />
        </li>
      ))}
    </Carousel>
  </Container>
</section>
