---
import { Image } from 'astro:assets';
import { site, whatsappHref } from '../../config/site';
import icon from '../../assets/logos/whatsapp.webp';

// PENDING P-L21: without a number the button points to the contact section.
const href = whatsappHref() ?? site.anchors.contact;
const external = href.startsWith('http');
---

<a
  href={href}
  class="fixed right-4 bottom-4 z-30 size-14 rounded-full shadow-lg shadow-navy/30 transition-transform hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue sm:right-6 sm:bottom-6 lg:size-16"
  aria-label="Escríbanos por WhatsApp"
  {...(external && { target: '_blank', rel: 'noopener noreferrer' })}
>
  <Image src={icon} alt="" width={64} densities={[1, 2]} class="size-full" />
</a>
