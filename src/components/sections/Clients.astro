---
import { Image } from 'astro:assets';
import Marquee from '../ui/Marquee.astro';
import { site } from '../../config/site';
import { clients } from '../../content/clients';

// Roughly constant speed regardless of how many brands there are.
const duration = clients.length * 4.5;
---

{site.clients.visible && (
  <section id="clientes" aria-label="Marcas aliadas" class="border-b border-ink/10 bg-white py-6">
    <Marquee label="Marcas aliadas" duration={duration}>
      {clients.map((client) => {
        const logo = (
          <Image
            src={client.logo}
            alt={client.name}
            height={80}
            densities={[1, 2]}
            loading="lazy"
            class="h-12 w-auto max-w-none mix-blend-multiply sm:h-16 lg:h-20"
          />
        );
        return (
          <li class="shrink-0">
            {client.href ? (
              <a href={client.href} target="_blank" rel="noopener noreferrer">
                {logo}
              </a>
            ) : (
              logo
            )}
          </li>
        );
      })}
    </Marquee>
  </section>
)}
