---
/**
 * Contact form (name, WhatsApp, email). Sends a FormData POST to
 * `site.contact.formEndpoint` and expects a JSON response. While the endpoint
 * is null it still validates, but shows a notice pointing to WhatsApp instead
 * of sending, so no lead is silently lost.
 */
import { site, whatsappHref } from '../../config/site';
import { finalCta } from '../../content/company';

const { form } = finalCta;
const { formEndpoint, formHiddenFields } = site.contact;
const { privacyPolicy } = site.links;
const whatsapp = whatsappHref();

const inputClass =
  'mt-1.5 w-full rounded-xl border border-ink/30 bg-white px-4 py-3 text-base text-ink placeholder:text-ink/50 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 focus:outline-none';
const labelClass = 'block text-sm font-medium text-ink';
---

<shalom-contact-form
  class="block"
  data-endpoint={formEndpoint ?? undefined}
  data-sending={form.sending}
  data-success={form.success}
  data-error={form.error}
  data-unavailable={form.unavailable}
>
  <h3 class="text-xl font-bold text-ink">{form.title}</h3>
  <p class="mt-1 text-sm text-ink/80">{form.lead}</p>

  <form class="mt-5 space-y-4" method="post" action={formEndpoint ?? undefined}>
    {Object.entries(formHiddenFields).map(([name, value]) => (
      <input type="hidden" name={name} value={value} />
    ))}
    <!-- Honeypot: hidden from people, filled by bots; the submission is dropped when it has a value. -->
    <div class="sr-only" aria-hidden="true">
      <label>
        No llenar este campo
        <input type="text" name="botcheck" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div>
      <label for="contact-name" class={labelClass}>
        {form.fields.name}
      </label>
      <input
        id="contact-name"
        name="name"
        type="text"
        required
        minlength="3"
        maxlength="80"
        autocomplete="name"
        class={inputClass}
      />
    </div>
    <div>
      <label for="contact-whatsapp" class={labelClass}>
        {form.fields.whatsapp}
      </label>
      <input
        id="contact-whatsapp"
        name="whatsapp"
        type="tel"
        inputmode="tel"
        required
        pattern="[0-9+\(\) \-]{7,20}"
        title="Ingrese un número de WhatsApp válido, por ejemplo 300 123 4567"
        autocomplete="tel"
        placeholder="300 123 4567"
        class={inputClass}
      />
    </div>
    <div>
      <label for="contact-email" class={labelClass}>
        {form.fields.email}
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        required
        maxlength="120"
        autocomplete="email"
        class={inputClass}
      />
    </div>

    <!-- Consent required by Ley 1581 de 2012. PENDING P-L20: policy URL. -->
    <label class="flex items-start gap-3 text-sm text-ink/90">
      <input
        type="checkbox"
        name="consent"
        value="yes"
        required
        class="mt-0.5 size-5 shrink-0 rounded border-ink/40 accent-brand-blue"
      />
      <span>
        {`${form.consent} `}
        {privacyPolicy ? (
          <a
            href={privacyPolicy}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-brand-blue underline underline-offset-2"
          >
            {`${form.consentLink}.`}
          </a>
        ) : (
          `${form.consentLink}.`
        )}
      </span>
    </label>

    <button
      type="submit"
      class="inline-flex w-full items-center justify-center rounded-full bg-brand-green px-6 py-3 text-sm font-bold tracking-wide text-white uppercase transition-colors hover:bg-brand-green/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green disabled:cursor-wait disabled:opacity-70"
    >
      {form.submit}
    </button>

    <p data-status role="status" aria-live="polite" class="hidden rounded-xl px-4 py-3 text-sm">
      <span data-status-text></span>
      {whatsapp && (
        <a
          data-status-whatsapp
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-1 hidden font-bold underline underline-offset-2"
        >
          Abrir WhatsApp
        </a>
      )}
    </p>
  </form>
</shalom-contact-form>

<script>
  type StatusKind = 'success' | 'error' | 'info';

  const STATUS_STYLES: Record<StatusKind, string[]> = {
    success: ['bg-brand-green/15', 'text-brand-green-text'],
    error: ['bg-red-50', 'text-red-800'],
    info: ['bg-sky', 'text-ink'],
  };

  class ShalomContactForm extends HTMLElement {
    private form!: HTMLFormElement;
    private submitBtn!: HTMLButtonElement;
    private status!: HTMLElement;
    private statusText!: HTMLElement;
    private whatsappLink: HTMLElement | null = null;
    private submitLabel = '';

    connectedCallback() {
      this.form = this.querySelector('form')!;
      this.submitBtn = this.form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      this.status = this.form.querySelector<HTMLElement>('[data-status]')!;
      this.statusText = this.form.querySelector<HTMLElement>('[data-status-text]')!;
      this.whatsappLink = this.form.querySelector<HTMLElement>('[data-status-whatsapp]');
      this.submitLabel = this.submitBtn.textContent ?? '';
      this.form.addEventListener('submit', (event) => this.onSubmit(event));
    }

    private async onSubmit(event: SubmitEvent) {
      // Native validation has already passed when this fires.
      event.preventDefault();
      const data = new FormData(this.form);

      // Bots fill the honeypot: pretend it worked and send nothing.
      if (data.get('botcheck')) {
        this.showStatus('success', this.dataset.success!);
        return;
      }
      data.delete('botcheck');

      const endpoint = this.dataset.endpoint;
      if (!endpoint) {
        this.showStatus('info', this.dataset.unavailable!, true);
        return;
      }

      this.submitBtn.disabled = true;
      this.submitBtn.textContent = this.dataset.sending!;
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        if (!response.ok) throw new Error(`Form service answered ${response.status}`);
        this.form.reset();
        this.showStatus('success', this.dataset.success!);
      } catch {
        this.showStatus('error', this.dataset.error!, true);
      } finally {
        this.submitBtn.disabled = false;
        this.submitBtn.textContent = this.submitLabel;
      }
    }

    private showStatus(kind: StatusKind, message: string, withWhatsapp = false) {
      this.status.classList.remove('hidden', ...Object.values(STATUS_STYLES).flat());
      this.status.classList.add(...STATUS_STYLES[kind]);
      this.statusText.textContent = message;
      this.whatsappLink?.classList.toggle('hidden', !withWhatsapp);
    }
  }

  customElements.define('shalom-contact-form', ShalomContactForm);
</script>
