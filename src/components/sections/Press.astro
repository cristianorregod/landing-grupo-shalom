---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Carousel from '../ui/Carousel.astro';
import ResponsiveImage from '../ui/ResponsiveImage.astro';
import { pressNotes, pressSection } from '../../content/press';
---

<section id="prensa" class="bg-white py-16 lg:py-20">
  <Container>
    <Eyebrow>{pressSection.eyebrow}</Eyebrow>

    <Carousel label="Notas de prensa" arrows gapClass="gap-4" class="mt-8">
      {pressNotes.map((note) => (
        <li class="w-[85%] sm:w-[calc((100%-1rem)/2)] lg:w-[calc((100%-2rem)/3)]">
          <article class="flex h-full flex-col rounded-2xl border-2 border-brand-blue p-3">
            <ResponsiveImage
              src={note.image}
              alt=""
              widths={[360, 527]}
              sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 85vw"
              class="aspect-[527/268] w-full rounded-lg object-cover"
            />
            {note.outlet && (
              <p class="mt-3 text-xs font-bold tracking-wider text-eyebrow uppercase">
                {note.outlet}
              </p>
            )}
            <h3 class="mt-3 line-clamp-3 text-sm leading-snug text-ink">{note.title}</h3>
            <div class="mt-auto flex justify-end pt-4">
              {note.href ? (
                <a
                  href={note.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-sm font-bold text-brand-blue hover:underline"
                  aria-label={`Leer más: ${note.title}`}
                >
                  Leer más <span aria-hidden="true">›</span>
                </a>
              ) : (
                <span
                  class="inline-flex cursor-not-allowed items-center gap-1 text-sm font-bold text-brand-blue opacity-50"
                  aria-disabled="true"
                  title="Enlace disponible próximamente"
                >
                  Leer más <span aria-hidden="true">›</span>
                </span>
              )}
            </div>
          </article>
        </li>
      ))}
    </Carousel>
  </Container>
</section>
