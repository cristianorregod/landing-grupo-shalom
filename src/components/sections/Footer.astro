---
import { Image } from 'astro:assets';
import { siFacebook, siInstagram, siTiktok, siYoutube } from 'simple-icons';
import Container from '../ui/Container.astro';
import { site } from '../../config/site';
import { footer } from '../../content/company';
import logo from '../../assets/logos/shalom-white.webp';

const year = new Date().getFullYear();
const linkClass = 'transition-colors hover:text-brand-green';
const externalAttrs = { target: '_blank', rel: 'noopener noreferrer' };

// PENDING P-L16: "Valores" stays hidden until it has a destination.
const companyLinks = [
  { label: 'Trayectoria', href: site.anchors.trajectory },
  { label: 'Garantía & Capacidad', href: site.anchors.guarantee },
  { label: 'Quiénes somos', href: site.pages.about },
  { label: 'Trabaja con nosotros', href: site.pages.jobs },
  { label: 'Contacto', href: site.pages.contact },
  { label: 'Valores', href: site.links.values },
].filter((link): link is { label: string; href: string } => link.href !== null);

const icons = {
  instagram: siInstagram,
  facebook: siFacebook,
  youtube: siYoutube,
  tiktok: siTiktok,
} as const;

const { email, phone, mapsUrl } = site.contact;
const { privacyPolicy, quote } = site.links;
---

<footer class="bg-navy text-white">
  <Container class="grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr] lg:py-16">
    <div class="max-w-sm">
      <Image
        src={logo}
        alt={site.name}
        height={104}
        densities={[1, 2]}
        class="h-20 w-auto sm:h-26"
      />
      <p class="mt-6 text-sm text-white/90 sm:text-base">{footer.tagline}</p>
      {site.social.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-3" aria-label="Redes sociales">
          {site.social.map((network) => (
            <li>
              <a
                href={network.href}
                {...externalAttrs}
                aria-label={`${site.name} en ${network.label}`}
                class="flex size-10 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-brand-green"
              >
                <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
                  <path d={icons[network.icon].path} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <nav aria-labelledby="footer-company" class="lg:pt-16">
      <h2 id="footer-company" class="text-sm font-bold tracking-wide uppercase">
        Compañía
      </h2>
      <ul class="mt-5 space-y-3 text-sm text-white/90 sm:text-base">
        {companyLinks.map((link) => (
          <li>
            <a href={link.href} class={linkClass}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="lg:pt-16">
      <h2 class="text-sm font-bold tracking-wide uppercase">Contacto</h2>
      <ul class="mt-5 space-y-3 text-sm text-white/90 sm:text-base">
        <li>
          <a href={`mailto:${email}`} class:list={[linkClass, 'break-all']}>
            {email}
          </a>
        </li>
        <li>
          <a href={phone.whatsappHref} {...externalAttrs} class={linkClass}>
            WhatsApp {phone.display}
          </a>
        </li>
        <li>
          {mapsUrl ? (
            <a href={mapsUrl} {...externalAttrs} class={linkClass}>
              {footer.location}
            </a>
          ) : (
            footer.location
          )}
        </li>
        <li>
          <a href={quote} class={linkClass} {...(quote.startsWith('http') && externalAttrs)}>
            Solicitar cotización
          </a>
        </li>
      </ul>
    </div>
  </Container>

  <div class="border-t border-white/20">
    <Container class="flex flex-col gap-3 py-6 pb-24 text-xs text-white/80 sm:text-sm md:flex-row md:items-center md:justify-between md:pb-6">
      <p>
        © {year} {site.name}. Todos los derechos reservados.
      </p>
      {privacyPolicy && (
        <a href={privacyPolicy} class={linkClass}>
          Política de privacidad
        </a>
      )}
      <p>{footer.slogan}</p>
    </Container>
  </div>
</footer>
