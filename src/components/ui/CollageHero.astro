---
/**
 * Internal page hero: text on the left (blue accent bar, optional intro line,
 * H1, default slot for paragraphs and buttons) and a three-photo collage on
 * the right (one wide on top, two below). The collage stacks under the text
 * below lg. Only the accent bar animates: the hero is above the fold (LCP).
 */
import type { ImageMetadata } from 'astro';
import Container from './Container.astro';
import ResponsiveImage from './ResponsiveImage.astro';

interface Photo {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  title: string;
  intro?: string;
  /** Uses the first three photos: one wide on top, two below. */
  photos: Photo[];
  tone?: 'white' | 'mist';
}

const { title, intro, photos, tone = 'white' } = Astro.props;
const [wide, left, right] = photos;
---

<section class:list={['py-14 lg:py-20', tone === 'mist' ? 'bg-mist' : 'bg-white']}>
  <Container class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
    <div>
      <span class="block h-1 w-16 bg-brand-blue" aria-hidden="true" data-reveal="line"></span>
      {intro && <p class="mt-5 text-base text-ink/90 sm:text-lg">{intro}</p>}
      <h1 class="mt-4 text-4xl leading-[1.05] font-bold text-balance text-ink sm:text-5xl xl:text-[3.5rem]">
        {title}
      </h1>
      <div class="mt-6 max-w-xl space-y-4 text-base text-ink/90 sm:text-lg">
        <slot />
      </div>
      {Astro.slots.has('actions') && (
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <slot name="actions" />
        </div>
      )}
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-4">
      <ResponsiveImage
        src={wide.src}
        alt={wide.alt}
        widths={[400, 600, 900]}
        sizes="(min-width: 1216px) 540px, (min-width: 1024px) 45vw, 100vw"
        priority
        class="col-span-2 aspect-[16/9] w-full rounded-3xl object-cover"
        pictureClass="col-span-2"
      />
      <ResponsiveImage
        src={left.src}
        alt={left.alt}
        widths={[300, 500]}
        sizes="(min-width: 1216px) 265px, (min-width: 1024px) 22vw, 50vw"
        class="aspect-square w-full rounded-3xl object-cover"
      />
      <ResponsiveImage
        src={right.src}
        alt={right.alt}
        widths={[300, 500]}
        sizes="(min-width: 1216px) 265px, (min-width: 1024px) 22vw, 50vw"
        class="aspect-square w-full rounded-3xl object-cover"
      />
    </div>
  </Container>
</section>
