---
/**
 * Scroll-snap carousel. Slides are passed as direct `<li>` children and control
 * their own width (e.g. `w-full`, `w-4/5 md:w-1/3`), which defines how many are
 * visible per breakpoint. Dots are generated per reachable scroll position.
 */
interface Props {
  label: string;
  /** Autoplay interval in ms. Disabled with `prefers-reduced-motion`. */
  autoplay?: number;
  arrows?: boolean;
  dots?: boolean;
  gapClass?: string;
  class?: string;
}

const {
  label,
  autoplay = 0,
  arrows = false,
  dots = true,
  gapClass = 'gap-4',
  class: className,
} = Astro.props;
---

<shalom-carousel data-autoplay={autoplay} class:list={['block', className]}>
  <div class="relative" role="region" aria-roledescription="carrusel" aria-label={label}>
    <ul
      data-track
      class:list={[
        'flex snap-x snap-mandatory overflow-x-auto scroll-smooth scrollbar-none motion-reduce:scroll-auto',
        gapClass,
      ]}
      tabindex="0"
    >
      <slot />
    </ul>

    {arrows && (
      <>
        <button
          type="button"
          data-prev
          class="absolute top-1/2 left-0 hidden size-10 -translate-x-full -translate-y-1/2 items-center justify-center text-brand-blue disabled:opacity-30 md:flex"
          aria-label="Anterior"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-7"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            aria-hidden="true"
          >
            <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button
          type="button"
          data-next
          class="absolute top-1/2 right-0 hidden size-10 translate-x-full -translate-y-1/2 items-center justify-center text-brand-blue disabled:opacity-30 md:flex"
          aria-label="Siguiente"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-7"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            aria-hidden="true"
          >
            <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </>
    )}
  </div>

  {dots && <div data-dots class="mt-3 flex justify-center" />}
</shalom-carousel>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  class ShalomCarousel extends HTMLElement {
    private track!: HTMLElement;
    private slides: HTMLElement[] = [];
    private dotsEl: HTMLElement | null = null;
    private prevBtn: HTMLButtonElement | null = null;
    private nextBtn: HTMLButtonElement | null = null;
    private pages = 1;
    private current = 0;
    private timer: number | undefined;
    private visible = false;
    private paused = false;

    connectedCallback() {
      this.track = this.querySelector<HTMLElement>('[data-track]')!;
      this.slides = Array.from(this.track.children) as HTMLElement[];
      this.dotsEl = this.querySelector('[data-dots]');
      this.prevBtn = this.querySelector('[data-prev]');
      this.nextBtn = this.querySelector('[data-next]');

      this.slides.forEach((slide, i) => {
        slide.classList.add('snap-start', 'shrink-0');
        slide.setAttribute('role', 'group');
        slide.setAttribute('aria-roledescription', 'diapositiva');
        slide.setAttribute('aria-label', `${i + 1} de ${this.slides.length}`);
      });

      this.prevBtn?.addEventListener('click', () => this.goTo(this.current - 1));
      this.nextBtn?.addEventListener('click', () => this.goTo(this.current + 1));
      this.track.addEventListener('scroll', this.onScroll, { passive: true });
      this.track.addEventListener('keydown', this.onKeydown);

      this.addEventListener('pointerenter', () => (this.paused = true));
      this.addEventListener('pointerleave', () => (this.paused = false));
      this.addEventListener('focusin', () => (this.paused = true));
      this.addEventListener('focusout', () => (this.paused = false));

      new ResizeObserver(() => this.layout()).observe(this.track);
      new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        this.syncAutoplay();
      }).observe(this);
      reducedMotion.addEventListener('change', () => this.syncAutoplay());

      this.layout();
    }

    private get step(): number {
      if (this.slides.length < 2) return this.track.clientWidth;
      return this.slides[1].offsetLeft - this.slides[0].offsetLeft;
    }

    private layout() {
      const perView = Math.max(1, Math.floor((this.track.clientWidth + 1) / this.step));
      this.pages = Math.max(1, this.slides.length - perView + 1);
      this.renderDots();
      this.update();
    }

    private renderDots() {
      if (!this.dotsEl) return;
      this.dotsEl.replaceChildren();
      this.dotsEl.hidden = this.pages <= 1;
      for (let i = 0; i < this.pages; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'group flex size-6 items-center justify-center';
        dot.setAttribute('aria-label', `Ir a la posición ${i + 1}`);
        dot.innerHTML =
          '<span class="size-2 rounded-full bg-brand-blue/30 transition-colors group-aria-current:bg-brand-blue"></span>';
        dot.addEventListener('click', () => this.goTo(i));
        this.dotsEl.append(dot);
      }
    }

    private goTo(page: number) {
      const target = (page + this.pages) % this.pages;
      this.track.scrollTo({
        left: target * this.step,
        behavior: reducedMotion.matches ? 'auto' : 'smooth',
      });
    }

    private onScroll = () => {
      const maxScroll = this.track.scrollWidth - this.track.clientWidth;
      const atEnd = this.track.scrollLeft >= maxScroll - 2;
      const page = atEnd ? this.pages - 1 : Math.round(this.track.scrollLeft / this.step);
      if (page !== this.current) {
        this.current = page;
        this.update();
      }
    };

    private onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        this.goTo(this.current + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        this.goTo(this.current - 1);
      }
    };

    private update() {
      this.dotsEl?.querySelectorAll('button').forEach((dot, i) => {
        if (i === this.current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (this.prevBtn) this.prevBtn.disabled = this.pages <= 1;
      if (this.nextBtn) this.nextBtn.disabled = this.pages <= 1;
    }

    private syncAutoplay() {
      window.clearInterval(this.timer);
      const interval = Number(this.dataset.autoplay);
      if (!interval || !this.visible || reducedMotion.matches || this.pages <= 1) return;
      this.timer = window.setInterval(() => {
        if (!this.paused && !document.hidden) this.goTo(this.current + 1);
      }, interval);
    }
  }

  customElements.define('shalom-carousel', ShalomCarousel);
</script>
