---
/**
 * Accessible tabs (WAI-ARIA tablist): 2x2 grid below lg, single pill row from lg.
 * Panels are `<TabPanel id>` children (default slot) whose id matches a tab id.
 * A URL hash equal to a tab id (e.g. `#horeca`) selects that tab, which lets
 * nav links deep-link into a specific tab.
 */
interface Tab {
  id: string;
  label: string;
}

interface Props {
  tabs: Tab[];
  label: string;
  defaultId?: string;
  class?: string;
}

const { tabs, label, defaultId = tabs[0]?.id, class: className } = Astro.props;
---

<shalom-tabs class:list={['block', className]}>
  <div class="flex justify-center">
    <div
      role="tablist"
      aria-label={label}
      class="grid w-full grid-cols-2 gap-1 rounded-3xl border border-ink/40 p-1.5 lg:flex lg:w-auto lg:max-w-full lg:rounded-full"
    >
      {tabs.map((tab) => {
        const selected = tab.id === defaultId;
        return (
          <button
            type="button"
            role="tab"
            id={tab.id}
            aria-controls={`${tab.id}-panel`}
            aria-selected={selected ? 'true' : 'false'}
            tabindex={selected ? 0 : -1}
            class="rounded-full px-3 py-2 text-sm leading-tight text-ink transition-colors hover:text-brand-blue aria-selected:bg-brand-blue aria-selected:text-white sm:px-5 sm:text-base lg:shrink-0 lg:whitespace-nowrap"
          >
            {tab.label}
          </button>
        );
      })}
    </div>
  </div>

  <slot />
</shalom-tabs>

<script>
  class ShalomTabs extends HTMLElement {
    private tabs: HTMLButtonElement[] = [];

    connectedCallback() {
      this.tabs = Array.from(this.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      this.tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => this.select(i));
        tab.addEventListener('keydown', (event) => this.onKeydown(event, i));
      });
      window.addEventListener('hashchange', this.syncFromHash);
      this.syncFromHash();
    }

    private syncFromHash = () => {
      const id = decodeURIComponent(window.location.hash.slice(1));
      const index = this.tabs.findIndex((tab) => tab.id === id);
      if (index >= 0) this.select(index, false);
    };

    private onKeydown(event: KeyboardEvent, index: number) {
      const last = this.tabs.length - 1;
      const next: Record<string, number> = {
        ArrowRight: index === last ? 0 : index + 1,
        ArrowLeft: index === 0 ? last : index - 1,
        Home: 0,
        End: last,
      };
      if (!(event.key in next)) return;
      event.preventDefault();
      this.select(next[event.key]);
    }

    private select(index: number, focus = true) {
      this.tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = this.querySelector<HTMLElement>(`#${CSS.escape(tab.id)}-panel`);
        if (panel) panel.hidden = !selected;
      });
      // No scrollIntoView here: it would cancel the anchor scroll of nav deep links.
      if (focus) this.tabs[index].focus({ preventScroll: true });
    }
  }

  customElements.define('shalom-tabs', ShalomTabs);
</script>
