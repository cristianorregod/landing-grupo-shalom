---
/** Panel for `Tabs`. `id` must match the id of its tab. */
interface Props {
  id: string;
  selected?: boolean;
  class?: string;
}

const { id, selected = false, class: className } = Astro.props;
---

<div
  role="tabpanel"
  id={`${id}-panel`}
  aria-labelledby={id}
  tabindex="0"
  hidden={!selected}
  class:list={['mt-8', className]}
>
  <slot />
</div>
