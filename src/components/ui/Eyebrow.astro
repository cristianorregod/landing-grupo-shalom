---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'p'> {
  tone?: 'blue' | 'green' | 'light';
}

const { tone = 'blue', class: className, ...attrs } = Astro.props;

const tones = {
  blue: 'text-eyebrow',
  green: 'text-brand-green',
  light: 'text-white/80',
} as const;
---

<p
  class:list={['text-xs font-medium tracking-[0.25em] uppercase', tones[tone], className]}
  {...attrs}
>
  <slot />
</p>
