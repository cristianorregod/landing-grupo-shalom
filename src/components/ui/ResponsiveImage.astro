---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS `sizes` hint; defaults to full viewport width. */
  sizes?: string;
  widths?: number[];
  /** Above-the-fold images: eager load with high fetch priority. */
  priority?: boolean;
  class?: string;
  pictureClass?: string;
  /** Fade and settle in on scroll (`data-reveal="image"`). Never on above-the-fold images. */
  reveal?: boolean;
}

const DEFAULT_WIDTHS = [480, 768, 1024, 1440, 1920];

const {
  src,
  alt,
  sizes = '100vw',
  widths = DEFAULT_WIDTHS,
  priority = false,
  class: className,
  pictureClass,
  reveal = false,
} = Astro.props;

// Never upscale beyond the source width.
const usableWidths = [...new Set([...widths.filter((w) => w < src.width), src.width])];
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  widths={usableWidths}
  sizes={sizes}
  priority={priority}
  class={className}
  pictureAttributes={{ class: pictureClass, 'data-reveal': reveal ? 'image' : undefined }}
/>
